# ════════════════════════════════════════════════════
#  CONFIGURAÇÕES DO BOT — edite este arquivo
#  Não use aspas nos valores!
# ════════════════════════════════════════════════════

# URL do seu servidor EvolutionAPI
# Se estiver na mesma máquina, use localhost
EVOLUTION_URL=http://localhost:8080

# API Key global do EvolutionAPI
# Encontre em: painel do Evolution > configurações
EVOLUTION_API_KEY=sua-chave-global-aqui

# Nome da instância conectada no EvolutionAPI
INSTANCE_NAME=nome-da-sua-instancia

# JID do grupo a ser monitorado
# Para descobrir: veja as instruções no README
# Formato: 120363XXXXXXXXXX@g.us
TARGET_GROUP_JID=120363000000000000@g.us

# Número do WhatsApp a ser monitorado dentro do grupo
# Formato: DDI + DDD + número, sem + ou espaços
# Exemplo: 5547999999999
TARGET_NUMBER=5511999999999

# Emoji que será enviado como resposta
EMOJI_REPLY=🔥

# Porta onde o bot vai escutar o webhook
WEBHOOK_PORT=5000

# Tempo (em segundos) para aguardar antes de verificar se fomos os primeiros
# Diminua para mais velocidade, aumente se a conexão for lenta
CHECK_DELAY_SECONDS=2.0

# Quantas vezes o bot vai tentar ser o primeiro antes de desistir
MAX_RETRIES=10
