# ════════════════════════════════════════════════════
#  Configuração de INFRAESTRUTURA
#  (instâncias, grupo alvo e nome alvo agora são
#   gerenciados pelo Telegram + SQLite — não vão aqui)
# ════════════════════════════════════════════════════

# EvolutionAPI
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-global-aqui

# Telegram
TELEGRAM_TOKEN=123456:ABC-DEF...

# chat_ids autorizados a operar o bot (separados por vírgula)
# Pegue o seu mandando /meuid no bot.
ADMIN_CHAT_IDS=123456789,987654321

# Porta do webhook
WEBHOOK_PORT=5000

# URL pública do bot (sem barra no fim). Usada para configurar
# automaticamente o webhook das instâncias na EvolutionAPI.
# Exemplo local: http://192.168.15.92:5000
# Exemplo público: https://meudominio.com
WEBHOOK_URL=http://192.168.15.92:5000
